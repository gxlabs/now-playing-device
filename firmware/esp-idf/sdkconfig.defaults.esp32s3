# Waveshare ESP32-S3-Touch-LCD-1.46 (ESP32-S3R8, 16MB flash / 8MB octal PSRAM)
# Applied on top of sdkconfig.defaults when the target is esp32s3.

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Octal PSRAM — holds the 412x412 RGB565 artwork frame (~332 kB), which does
# not fit in internal SRAM alongside the LVGL draw buffers.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 240 MHz: QSPI flushes of a 412x412 panel are CPU-bound on pixel blitting.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# LVGL's internal pool. 64 kB (the default) is sized for a 240px screen; the
# 412px layers and scrolling labels need more headroom.
CONFIG_LV_MEM_SIZE=98304
